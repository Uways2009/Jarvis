# ─────────────────────────────────────────────────────────────────────────────
# NEXOVIRA — environment
# Copy to `.env` (local) and fill in. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telephony ────────────────────────────────────────────────────────────────
# Twilio Console → Account Info. The Auth Token is also the webhook signing key.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# A voice-capable number you own, in E.164 format. This is the caller ID.
TWILIO_FROM_NUMBER=

# Optional: restrict dispatch to a single outbound trunk / BYOC
# TWILIO_BYOC_SID=

# ── Voice synthesis ──────────────────────────────────────────────────────────
# https://fish.audio → API keys. TTS is billed per character.
FISH_AUDIO_API_KEY=

# Voice model id (reference_id). Find it in the voice's URL on fish.audio.
# Leave blank to use Fish's default voice.
FISH_AUDIO_REFERENCE_ID=

# s2.1-pro-free | s2.1-pro | s2-pro | s1
FISH_AUDIO_MODEL=s2.1-pro-free

# ── Reachability ─────────────────────────────────────────────────────────────
# Twilio must be able to fetch your TwiML and audio over the public internet.
# Set this to your public origin (ngrok / Cloudflare tunnel / deployed domain).
# If blank, the app derives it from the incoming request host.
PUBLIC_BASE_URL=

# ── Safety gates ─────────────────────────────────────────────────────────────
# The console will NOT place live calls unless this is exactly `armed`.
# Every live call also requires a typed authorization phrase in the UI.
NEXOVIRA_LIVE_CALLS=disarmed

# Verify the X-Twilio-Signature header on inbound webhooks. Keep `true` in production.
TWILIO_VALIDATE_SIGNATURE=true

# Daily ceiling on live outbound calls, and cooldown per number (hours).
NEXOVIRA_DAILY_CALL_CAP=25
NEXOVIRA_NUMBER_COOLDOWN_HOURS=24

# ── Optional: language-model polish on composed scripts ──────────────────────
# Either key enables LLM refinement. Without one, the deterministic
# composition engine runs and the app remains fully functional.
GEMINI_API_KEY=
OPENAI_API_KEY=
NEXOVIRA_LLM_MODEL=
