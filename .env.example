# ─────────────────────────────────────────────────────────────────────────────
# NEXOVIRA — environment
# Copy to `.env` (local) and fill in. Never commit `.env`.
# Every variable below is optional: without it, the app degrades honestly and
# tells you what is missing on the console.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telephony (Twilio) ───────────────────────────────────────────────────────
# Twilio Console → Account Info. The Auth Token also signs webhooks.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# A voice-capable number you own, in E.164. This is the caller ID.
# TWILIO_PHONE_NUMBER and TWILIO_CALLER_ID are accepted as aliases.
TWILIO_FROM_NUMBER=

# Optional: the human who receives warm transfers when a prospect asks for one.
# Falls back to the callback number on the business profile.
TWILIO_TRANSFER_NUMBER=

# ── Voice synthesis (Fish Audio) ─────────────────────────────────────────────
# https://fish.audio → API keys. TTS bills per character.
FISH_AUDIO_API_KEY=

# Voice model id — Fish calls this `reference_id`; it is the id in the voice's
# URL on fish.audio. FISH_AUDIO_VOICE_ID is accepted as an alias.
# Blank uses Fish's platform default voice.
FISH_AUDIO_REFERENCE_ID=

# s2.1-pro-free | s2.1-pro | s2-pro | s1
# s2.1-pro-free is the same weights as s2.1-pro at zero cost — prototype there.
FISH_AUDIO_MODEL=s2.1-pro-free

# ── Optional: language-model polish on composed scripts ──────────────────────
# Any one of these enables refinement of the persuasion surfaces only. The AI
# disclosure and opt-out lines are never sent for rewriting.
# Without a key the deterministic engine runs alone, and that is a fully
# supported mode, not a degraded one.
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Only needed to override a provider's default model.
# Groq default: llama-3.3-70b-versatile
# Gemini default: gemini-2.5-flash   OpenAI default: gpt-4o-mini
NEXOVIRA_LLM_MODEL=

# ── Reachability ─────────────────────────────────────────────────────────────
# Twilio must be able to fetch your TwiML and audio over the public internet.
# Set this to a public origin (a tunnel or your deployed domain) before live
# dialling — otherwise Twilio fetches nothing and calls die on answer.
PUBLIC_BASE_URL=

# ── Safety gates ─────────────────────────────────────────────────────────────
# The console will NOT place live calls unless this is exactly `armed`.
# Every live call also requires a typed authorisation phrase in the UI.
NEXOVIRA_LIVE_CALLS=disarmed

# Verify the X-Twilio-Signature header on inbound webhooks. Keep `true`.
TWILIO_VALIDATE_SIGNATURE=true

# Daily ceiling on live outbound calls, and cooldown per number (hours).
NEXOVIRA_DAILY_CALL_CAP=25
NEXOVIRA_NUMBER_COOLDOWN_HOURS=24

# Where runtime state lives (profile, call log, clips, suppression list).
# NEXOVIRA_DATA_DIR=./data
